generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Auth ──────────────────────────────────────────────────────────────────────

model Company {
  id                 String   @id @default(cuid())
  name               String
  slug               String?  @unique
  razaoSocial        String?
  cnpj               String?
  inscricaoEstadual  String?
  inscricaoMunicipal String?
  cep                String?
  rua                String?
  numero             String?
  bairro             String?
  complemento        String?
  cidade             String?
  estado             String?
  telefone           String?
  email              String?
  site               String?
  logoUrl            String?
  banco              String?
  agencia            String?
  conta              String?
  pix                String?
  responsavel        String?
  naturezaOperacao   String?  @default("LOCAÇÃO DE BENS MÓVEIS")
  observacaoFatura   String?
  diasSemana         Int      @default(7)
  diasQuinzena       Int      @default(15)
  diasMes            Int      @default(30)
  descontoSemana     Float    @default(0)
  descontoQuinzena   Float    @default(0)
  descontoMes        Float    @default(0)
  permitirPrecoManual Boolean @default(true)
  // Numeração inicial (onboarding/migração): o 1º documento continua a partir daqui
  orcamentoNumeroInicial Int? // ex.: 1000 → o próximo orçamento sai como #1000
  faturaNumeroInicial    Int? // ex.: 500  → a próxima fatura sai como #500
  menuConfig         Json?
  tiposEvento        Json?
  icsToken           String?  @unique // token do link privado de agenda (Google Agenda etc.)
  // Assistente de WhatsApp da empresa (WhatsApp Business Cloud API)
  whatsappAssistente String?  // nome do assistente escolhido pela empresa (ex.: NESTOR)
  whatsappNumero     String?  // número exibido (ex.: +55 11 99999-9999)
  whatsappPhoneId    String?  // Phone Number ID da Cloud API (Meta)
  whatsappToken      String?  // token de acesso permanente da Cloud API
  whatsappTemplates  Json?    // textos das mensagens (ESCALA/ALTERACAO/LEMBRETE) editáveis pelo admin
  osPublicaConfig    Json?    // seções visíveis na OS pública (decisão do admin, por empresa)
  // Catálogo público: botão de WhatsApp (texto, mensagem e se aparece)
  catalogoWhatsappAtivo    Boolean @default(true)
  catalogoWhatsappTexto    String?
  catalogoWhatsappMensagem String?
  // Inteligência Artificial (Claude API) — por empresa
  iaApiKey           String?  // chave da API Anthropic (nunca exibida de volta)
  iaInstrucoes       String?  // (legado) skill do gerador de propostas — migrada para iaSkills
  iaSkills           Json?    // skills nomeadas: [{id, nome, tipo, instrucoes}] tipo=PROPOSTA|ESCALA|GERAL
  tiposManutencao    Json?    // classificações de manutenção de veículos criadas pela empresa
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  users      User[]
  contacts   Contact[]
  locals     Local[]
  categorias Categoria[]
  itens      Item[]
  marcas     Marca[]
  orcamentos Orcamento[]
  membros    Membro[]
  tarefas    Tarefa[]
  transacoes Transacao[]
  faturas    Fatura[]
  links      Link[]
  veiculos   Veiculo[]
  eventos    Evento[]
  contratos  Contrato[]
  metodosPagamento MetodoPagamento[]
  bancos           Banco[]
  modelosContrato  ModeloContrato[]
  arquivos         CompanyArquivo[]
}

// Documentos e links da empresa: cartão CNPJ, docs fiscais, pastas do Drive...
model CompanyArquivo {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tipo      String   // ARQUIVO | LINK
  titulo    String
  url       String   // /api/arquivos/{id} para arquivos, URL externa para links
  arquivoId String?
  criadoPor String?
  createdAt DateTime @default(now())
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("USER")
  isOwner       Boolean   @default(false)
  ativo         Boolean   @default(true)
  permissions   Json?
  tarefasIcsToken String? @unique // link privado de tarefas do usuário (Google Agenda)
  companyId     String?
  company       Company?  @relation(fields: [companyId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  tarefasCriadas Tarefa[]  @relation("TarefaCriador")
  tarefasAtribuidas TarefaUsuario[]
  membro         Membro?   // perfil de equipe vinculado (usuário que também é membro)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Contacts (Clientes + Fornecedores) ────────────────────────────────────────

model Contact {
  id                 String        @id @default(cuid())
  type               String
  razaoSocial        String
  nomeFantasia       String
  cnpj               String?
  inscricaoEstadual  String?
  inscricaoMunicipal String?
  cep                String?
  rua                String?
  numero             String?
  semNumero          Boolean       @default(false)
  bairro             String?
  complemento        String?
  cidade             String?
  estado             String?
  perfil             String?
  isPostoServico     Boolean       @default(false)
  bubbleId           String?       // id de origem (Bubble) — para cruzar importações
  companyId          String
  company            Company       @relation(fields: [companyId], references: [id])
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  subContacts SubContact[]
  orcamentos  Orcamento[]
  orcamentosComoCliente2 Orcamento[] @relation("OrcamentoCliente2")
  extrasFornecidos OsItemExtra[] @relation("ExtraFornecedor")
  faturas     Fatura[]
  contratos   Contrato[]
}

model SubContact {
  id        String   @id @default(cuid())
  nome      String
  telefone  String?
  email     String?
  cargo     String?
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  orcamentosComoContato1 Orcamento[] @relation("OrcContato1")
  orcamentosComoContato2 Orcamento[] @relation("OrcContato2")
}

// ── Locais ────────────────────────────────────────────────────────────────────

model Local {
  id          String   @id @default(cuid())
  nome        String
  cep         String?
  rua         String?
  numero      String?
  bairro      String?
  complemento String?
  cidade      String?
  estado      String?
  lat         Float?
  lng         Float?
  observacoes String?
  bubbleId    String?  // id de origem (Bubble) — para cruzar importações
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orcamentos Orcamento[]
}

// ── Ativos ────────────────────────────────────────────────────────────────────

model Categoria {
  id        String        @id @default(cuid())
  nome      String
  tipo      String
  companyId String
  company   Company       @relation(fields: [companyId], references: [id])
  createdAt DateTime      @default(now())

  subCategorias SubCategoria[]
  itens         Item[]
  transacoes    Transacao[]
}

model SubCategoria {
  id          String    @id @default(cuid())
  nome        String
  categoriaId String
  categoria   Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  itens Item[]
}

model Marca {
  id        String   @id @default(cuid())
  nome      String
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())

  itens Item[]
}

model Item {
  id             String       @id @default(cuid())
  codigo         String
  nome           String
  modelo         String?      // modelo do fabricante (ex.: MAC Aura XB)
  apelidos       String?
  valorAluguel   Float        @default(0)
  valorSemana    Float?
  valorQuinzena  Float?
  valorMes       Float?
  precoManual    Boolean      @default(false)
  natureza       String       @default("EQUIPAMENTO") // EQUIPAMENTO (locação) | SERVICO (prestação, sem estoque)
  valorReposicao Float?       // custo de reposição em caso de perda/dano
  cobranca       String?      // p/ serviços: FIXO | HORA | DIARIA
  watts          Float?
  kva            Float?
  tipo           String
  categoriaId    String?
  categoria      Categoria?   @relation(fields: [categoriaId], references: [id])
  subCategoriaId String?
  subCategoria   SubCategoria? @relation(fields: [subCategoriaId], references: [id])
  marcaId        String?
  marca          Marca?       @relation(fields: [marcaId], references: [id])
  quantidade     Int          @default(0)
  especificacoes String?
  fotos          String       @default("[]")
  emCatalogo     Boolean      @default(true)
  publicado      Boolean      @default(false)
  slug           String?
  descricaoComercial     String?
  especificacoesPublicas String?
  observacaoInterna      String?
  fotoCapaUrl    String?
  videoUrl       String?
  mostrarCodigo  Boolean      @default(false)
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  acessoriosBase ItemAcessorio[] @relation("ItemBase")
  acessoriosVinc ItemAcessorio[] @relation("ItemAcessorio")
  acessoriosAvulsos ItemAcessorioAvulso[]
  arquivos       ItemArquivo[]
  salaItens      SalaItem[]
  faturaItens    FaturaItem[]
  conferencias   OsConferencia[]
  unidades       ItemUnidade[]
  osExtras       OsItemExtra[]
  kitItens       KitItem[]

  @@unique([companyId, slug])
}

model ItemAcessorio {
  id          String @id @default(cuid())
  itemBaseId  String
  itemBase    Item   @relation("ItemBase", fields: [itemBaseId], references: [id], onDelete: Cascade)
  acessorioId String
  acessorio   Item   @relation("ItemAcessorio", fields: [acessorioId], references: [id])

  @@unique([itemBaseId, acessorioId])
}

// Acessório avulso do item (sem código/QR): checklist de separação do material.
// Ex.: microfone SLXD → base, bastão, fonte da base, pilhas, antenas.
model ItemAcessorioAvulso {
  id         String @id @default(cuid())
  itemId     String
  item       Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  nome       String
  quantidade Int    @default(1)
}

// Arquivos do item: manuais, apresentações, vídeo-tutoriais... qualquer espécie
model ItemArquivo {
  id        String   @id @default(cuid())
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tipo      String   // ARQUIVO | LINK
  titulo    String
  url       String   // /api/arquivos/{id} para arquivos, URL externa para links
  arquivoId String?
  criadoPor String?
  createdAt DateTime @default(now())
}

// ── Orçamentos ──────────────────────────────────────────────────────────────────

model Evento {
  id        String   @id @default(cuid())
  nome      String
  tipo      String?
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())

  orcamentos Orcamento[]
}

model Orcamento {
  id             String   @id @default(cuid())
  numero         Int
  clienteId      String
  cliente        Contact  @relation(fields: [clienteId], references: [id])
  cliente2Id     String?
  cliente2       Contact? @relation("OrcamentoCliente2", fields: [cliente2Id], references: [id])
  contatoId      String?
  contato        SubContact? @relation("OrcContato1", fields: [contatoId], references: [id])
  contato2Id     String?
  contato2       SubContact? @relation("OrcContato2", fields: [contato2Id], references: [id])
  status         String   @default("PENDENTE")
  eventoId       String?
  evento         Evento?  @relation(fields: [eventoId], references: [id])
  eventoNome     String?
  localId        String?
  local          Local?   @relation(fields: [localId], references: [id])
  tipoEvento     String?
  dataMontagem   DateTime?
  dataInicio     DateTime?
  dataFim        DateTime?
  observacoes    String?
  obsInternas    String?
  formaPagamento String?
  condicoes      String?
  desconto       Float?
  descontoTipo   String?  @default("valor")
  total          Float    @default(0)
  // Projeto especial: proposta em texto livre (Markdown) em vez de itens/salas
  projetoEspecial Boolean @default(false)
  conteudoProjeto String? // Markdown/texto colado pelo usuário
  valorProjeto    Float?  // valor total do projeto (antes do desconto)
  // Posto de serviço: consolidação mensal — qual fatura mensal já absorveu este orçamento
  postoFaturaId   String?
  aprovadoEm     DateTime?
  aprovadoPor    String?
  aprovacaoToken String?  @unique
  aprovadoOnlineEm  DateTime?
  aprovadoOnlinePor String?
  aprovadoOnlineIp  String?
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  salas      Sala[]
  transacoes Transacao[]
  faturas    Fatura[]
  contratos  Contrato[]
  os         OrdemServico?
  followUps  CrmFollowUp[]
}

// CRM: registro de contatos para cobrar feedback de orçamentos não aprovados
model CrmFollowUp {
  id          String    @id @default(cuid())
  companyId   String
  orcamentoId String
  orcamento   Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  canal       String?   // WHATSAPP | EMAIL | TELEFONE | OUTRO
  observacao  String?
  resultado   String?   // SEM_RESPOSTA | NEGOCIANDO | VAI_PENSAR | GANHOU | PERDEU
  proximaData DateTime? // próximo follow-up agendado manualmente (sobrepõe a cadência)
  autor       String?
  createdAt   DateTime  @default(now())

  @@index([companyId, orcamentoId])
}

model Sala {
  id          String    @id @default(cuid())
  nome        String
  orcamentoId String
  orcamento   Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  itens SalaItem[]
}

model SalaItem {
  id            String @id @default(cuid())
  salaId        String
  sala          Sala   @relation(fields: [salaId], references: [id], onDelete: Cascade)
  itemId        String
  item          Item   @relation(fields: [itemId], references: [id])
  quantidade    Int    @default(1)
  diarias       Int    @default(1)
  valorUnitario Float  @default(0)
  subtotal      Float  @default(0)
  descricaoComercial String?
}

// ── Ordem de Serviço ──────────────────────────────────────────────────────────

model OrdemServico {
  id                 String   @id @default(cuid())
  orcamentoId        String   @unique
  orcamento          Orcamento @relation(fields: [orcamentoId], references: [id])
  publicToken        String?  @unique // link público simplificado da OS (sem valores)
  produtores         Json?    // contatos do evento [{nome, telefone, funcao}] — clicáveis p/ WhatsApp
  infoEvento         String?  // texto livre do responsável sobre o evento (aparece na OS pública)
  infoEventoEm       DateTime? // quando as informações do evento mudaram pela última vez
  infoEventoPor      String?  // quem alterou por último
  status             String   @default("ABERTA")
  horarioMontagem    DateTime?
  obsMontagem        String?  // texto livre (ex.: "combinei de chegar às 13h")
  horarioDesmontagem DateTime?
  obsDesmontagem     String?  // texto livre (ex.: "previsto para terminar às 22h")
  obsLocal           String?  // texto livre do local (ex.: "entrada pelo portão 5")
  observacoes        String?
  // Pós-evento: fechamento com sucessos, problemas e feedback do cliente
  posSucessos        String?
  posProblemas       String?
  posFeedback        String?
  posComentarios     String?
  posEventoEm        DateTime?
  posEventoPor       String?
  companyId          String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  escala       EscalaMembro[]
  conferencias OsConferencia[]
  unidadesNoEvento ItemUnidade[]
  itensExtras  OsItemExtra[]
  mensagensWhatsapp MensagemWhatsapp[]
  anexos       OsAnexo[]
  alteracoes   OsAlteracao[]
  entrega      OsEntrega?
  veiculos     OsVeiculo[]
}

// Histórico de alterações da OS — visível também na OS pública, para toda a equipe
model OsAlteracao {
  id        String       @id @default(cuid())
  osId      String
  os        OrdemServico @relation(fields: [osId], references: [id], onDelete: Cascade)
  descricao String
  autor     String?
  createdAt DateTime     @default(now())
}

// Arquivos e links da OS (briefings, PDFs, PPTs, vídeos, drives...) para a equipe
model OsAnexo {
  id        String       @id @default(cuid())
  osId      String
  os        OrdemServico @relation(fields: [osId], references: [id], onDelete: Cascade)
  tipo      String       // ARQUIVO | LINK
  titulo    String
  url       String       // /api/arquivos/{id} para arquivos, URL externa para links
  arquivoId String?      // referência ao Arquivo quando tipo = ARQUIVO
  criadoPor String?
  createdAt DateTime     @default(now())
}

// Entrega no evento — "o que ficou" com o cliente (termo + aceite assinado).
// itens: snapshot [{ itemId, nome, codigo, separado, ficou }]
model OsEntrega {
  id               String       @id @default(cuid())
  osId             String       @unique
  os               OrdemServico @relation(fields: [osId], references: [id], onDelete: Cascade)
  publicToken      String       @unique
  itens            Json         @default("[]")
  observacoes      String?
  clienteNome      String?
  clienteDoc       String?
  aceiteAssinatura String?      // dataURL (PNG) da assinatura desenhada
  aceiteEm         DateTime?
  aceiteDispositivo String?
  registradoPor    String?
  companyId        String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

// NESTOR — log de mensagens de WhatsApp enviadas à equipe
model MensagemWhatsapp {
  id        String        @id @default(cuid())
  companyId String
  osId      String?
  os        OrdemServico? @relation(fields: [osId], references: [id], onDelete: SetNull)
  membroId  String?
  membro    Membro?       @relation(fields: [membroId], references: [id], onDelete: SetNull)
  telefone  String
  tipo      String        // ESCALA | ALTERACAO | LEMBRETE | AVULSA
  mensagem  String
  status    String        @default("ENVIADA") // ENVIADA | ERRO | LINK (aberta no WhatsApp Web)
  erro      String?
  enviadoPor String?      // nome do usuário (ou "NESTOR" nos automáticos)
  createdAt DateTime      @default(now())
}

// Item lançado direto na OS (fora do orçamento): esquecido pelo comercial ou acessório operacional
model OsItemExtra {
  id            String       @id @default(cuid())
  osId          String
  os            OrdemServico @relation(fields: [osId], references: [id], onDelete: Cascade)
  itemId        String
  item          Item         @relation(fields: [itemId], references: [id])
  quantidade    Int          @default(1)
  observacao    String?
  adicionadoPor String?
  // Sub-locação (cross-hire): equipamento alugado de terceiro para cobrir falta
  fornecedorId  String?
  fornecedor    Contact?     @relation("ExtraFornecedor", fields: [fornecedorId], references: [id])
  custo         Float?
  createdAt     DateTime     @default(now())

  @@unique([osId, itemId])
}

// Kit/pacote de itens (ex.: "Kit Palco P" adiciona vários itens de uma vez)
model Kit {
  id        String    @id @default(cuid())
  nome      String
  descricao String?
  companyId String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  itens     KitItem[]
}

model KitItem {
  id            String @id @default(cuid())
  kitId         String
  kit           Kit    @relation(fields: [kitId], references: [id], onDelete: Cascade)
  itemId        String
  item          Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantidade    Int    @default(1)
  valorUnitario Float? // preço manual do item no kit (null = usa a diária do item)
}

// Registro de entrada/saída de equipamentos do estoque na OS (auditável)
model OsConferencia {
  id            String       @id @default(cuid())
  osId          String
  os            OrdemServico @relation(fields: [osId], references: [id], onDelete: Cascade)
  itemId        String
  item          Item         @relation(fields: [itemId], references: [id])
  unidadeId     String?
  unidade       ItemUnidade? @relation(fields: [unidadeId], references: [id], onDelete: SetNull)
  tipo          String       // SAIDA (foi para o evento) | ENTRADA (voltou ao estoque)
  quantidade    Int          @default(1)
  registradoPor String?
  createdAt     DateTime     @default(now())
}

// Unidade física serializada de um item (ex.: Par LED RGBW → 0012-01 ... 0012-08)
model ItemUnidade {
  id        String   @id @default(cuid())
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  numero    Int
  codigo    String   // código único da unidade na empresa (codigoItem-NN)
  status    String   @default("EM_ESTOQUE") // EM_ESTOQUE | NO_EVENTO | MANUTENCAO | BAIXADA
  proximaManutencao DateTime?
  osId      String?  // OS em que a unidade está (quando NO_EVENTO)
  os        OrdemServico? @relation(fields: [osId], references: [id], onDelete: SetNull)
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conferencias OsConferencia[]

  @@unique([companyId, codigo])
  @@unique([itemId, numero])
}

model EscalaMembro {
  id             String       @id @default(cuid())
  osId           String
  os             OrdemServico @relation(fields: [osId], references: [id], onDelete: Cascade)
  membroId       String
  membro         Membro       @relation(fields: [membroId], references: [id])
  horarioEntrada DateTime?
  horarioSaida   DateTime?
  funcao         String?
  cache          Float?
}

// ── Equipe ────────────────────────────────────────────────────────────────────

model Especialidade {
  id        String   @id @default(cuid())
  nome      String   // ex.: "Técnico de som básico", "Técnico de informática avançado"
  companyId String?  // multiempresa (null apenas em registros antigos)
  createdAt DateTime @default(now())

  membros MembroEspecialidade[]
}

model Membro {
  id        String   @id @default(cuid())
  nome      String
  telefone  String?
  email     String?
  rg        String?
  cpf       String?
  tipo      String
  pix       String?
  cache     Float?
  fotoUrl   String?
  userId    String?  @unique // usuário do sistema vinculado (ex.: Well é usuário E membro)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  especialidades MembroEspecialidade[]
  avaliacoes     Avaliacao[]
  tarefas        TarefaMembro[]
  escala         EscalaMembro[]
  mensagensWhatsapp MensagemWhatsapp[]
}

model MembroEspecialidade {
  id              String        @id @default(cuid())
  membroId        String
  membro          Membro        @relation(fields: [membroId], references: [id], onDelete: Cascade)
  especialidadeId String
  especialidade   Especialidade @relation(fields: [especialidadeId], references: [id])

  @@unique([membroId, especialidadeId])
}

// Feedback de freelancers/membros: nota geral + critérios (1 a 5) e comentário
model Avaliacao {
  id           String   @id @default(cuid())
  membroId     String
  membro       Membro   @relation(fields: [membroId], references: [id], onDelete: Cascade)
  nota         Int      // nota geral 1-5 (usada na classificação)
  postura      Int?     // 1-5
  tecnica      Int?     // conhecimento técnico 1-5
  pontualidade Int?     // 1-5
  proatividade Int?     // 1-5
  comentario   String?
  evento       String?  // evento/OS de referência (texto livre)
  autor        String?  // quem avaliou
  createdAt    DateTime @default(now())
}

model Veiculo {
  id              String   @id @default(cuid())
  placa           String
  modelo          String
  ano             Int?
  tipo            String?
  capacidadeCarga String?
  rodizioDia      Int?     // dia de rodízio: 1=seg ... 5=sex (regra SP pelo final da placa)
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  createdAt       DateTime @default(now())

  osVeiculos  OsVeiculo[]
  arquivos    VeiculoArquivo[]
  manutencoes VeiculoManutencao[]
}

// Documentos do veículo (CRLV em PDF, seguro...) e comprovantes de manutenção
model VeiculoArquivo {
  id           String   @id @default(cuid())
  veiculoId    String
  veiculo      Veiculo  @relation(fields: [veiculoId], references: [id], onDelete: Cascade)
  manutencaoId String?  // quando é comprovante/foto de uma manutenção específica
  tipo         String   // ARQUIVO | LINK
  titulo       String
  url          String
  arquivoId    String?
  criadoPor    String?
  createdAt    DateTime @default(now())
}

// Manutenções do veículo — cadastro genérico (troca de óleo, pneus, revisão,
// freios, funilaria...), com km, custo, próxima prevista e comprovantes.
model VeiculoManutencao {
  id          String    @id @default(cuid())
  veiculoId   String
  veiculo     Veiculo   @relation(fields: [veiculoId], references: [id], onDelete: Cascade)
  tipo        String    // texto livre: "Troca de óleo", "Pneus", "Revisão 30.000 km"...
  data        DateTime
  km          Int?      // quilometragem no momento
  custo       Float?
  descricao   String?   // o que foi feito
  proximaData DateTime? // próxima manutenção prevista (por data)
  proximaKm   Int?      // ou por quilometragem
  observacoes String?   // ex.: "próxima troca em 10.000 km ou 6 meses"
  criadoPor   String?
  createdAt   DateTime  @default(now())
}

// Escala de veículos da OS (com alerta de rodízio no dia do evento/montagem)
model OsVeiculo {
  id         String       @id @default(cuid())
  osId       String
  os         OrdemServico @relation(fields: [osId], references: [id], onDelete: Cascade)
  veiculoId  String
  veiculo    Veiculo      @relation(fields: [veiculoId], references: [id])
  motorista  String?
  observacao String?
}

// ── Financeiro ──────────────────────────────────────────────────────────────────

model Transacao {
  id              String    @id @default(cuid())
  dataRecebimento DateTime
  nome            String
  tipo            String
  categoriaId     String?
  categoria       Categoria? @relation(fields: [categoriaId], references: [id])
  orcamentoId     String?
  orcamento       Orcamento? @relation(fields: [orcamentoId], references: [id])
  faturaId        String?
  fatura          Fatura?   @relation(fields: [faturaId], references: [id])
  valor           Float
  bancoId         String?
  banco           Banco?    @relation(fields: [bancoId], references: [id])
  observacao      String?
  notaFiscal      Boolean   @default(false)
  status          String    @default("PENDENTE")
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Fatura {
  id               String    @id @default(cuid())
  numero           Int
  snapshot         Json?
  emitidaEm        DateTime?
  emitidaPor       String?
  tipoDestinatario String    @default("CLIENTE")
  origem           String    @default("ORCAMENTO")
  justificativa    String?
  isPostoServico Boolean   @default(false)
  orcamentoId    String?
  orcamento      Orcamento? @relation(fields: [orcamentoId], references: [id])
  clienteId      String?
  cliente        Contact?  @relation(fields: [clienteId], references: [id])
  clienteNome    String
  mesRef         String
  dataEmissao    DateTime
  dataVencimento DateTime
  valor          Float
  descritivo     String?
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  itens      FaturaItem[]
  transacoes Transacao[]
}

model FaturaItem {
  id            String  @id @default(cuid())
  faturaId      String
  fatura        Fatura  @relation(fields: [faturaId], references: [id], onDelete: Cascade)
  itemId        String?
  item          Item?   @relation(fields: [itemId], references: [id])
  descricao     String
  periodo       String  @default("DIARIA")
  quantidade    Int     @default(1)
  valorUnitario Float   @default(0)
  subtotal      Float   @default(0)
}

// ── Tarefas ───────────────────────────────────────────────────────────────────

model Tarefa {
  id          String   @id @default(cuid())
  nome        String
  instrucoes  String?
  dataInicio  DateTime
  dataEntrega DateTime
  obsExecucao String?
  status      String   @default("NAO_INICIADA")
  criadorId   String
  criador     User     @relation("TarefaCriador", fields: [criadorId], references: [id])
  // Recorrência (estilo Google Agenda): ao concluir, gera a próxima ocorrência
  recorrencia    String?   // DIARIA | SEMANAL | MENSAL | ANUAL (null = tarefa única)
  recorrenciaAte DateTime? // limite opcional; sem isto repete indefinidamente
  recorrenteDe   String?   // id da tarefa que originou esta ocorrência
  crmOrcamentoId String?   // tarefa de follow-up gerada automaticamente pela rotina de CRM
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  responsaveis TarefaMembro[]
  atribuidos   TarefaUsuario[]
}

// Usuários do sistema atribuídos a uma tarefa (ex.: Ricardo atribui p/ Wellington)
model TarefaUsuario {
  id       String @id @default(cuid())
  tarefaId String
  tarefa   Tarefa @relation(fields: [tarefaId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id])

  @@unique([tarefaId, userId])
}

model TarefaMembro {
  id       String @id @default(cuid())
  tarefaId String
  tarefa   Tarefa @relation(fields: [tarefaId], references: [id], onDelete: Cascade)
  membroId String
  membro   Membro @relation(fields: [membroId], references: [id])

  @@unique([tarefaId, membroId])
}

// ── Contratos ──────────────────────────────────────────────────────────────────

model Contrato {
  id          String    @id @default(cuid())
  titulo      String
  clienteId   String
  cliente     Contact   @relation(fields: [clienteId], references: [id])
  orcamentoId String?
  orcamento   Orcamento? @relation(fields: [orcamentoId], references: [id])
  status      String    @default("RASCUNHO")
  conteudo    String?   // conteúdo da versão atual
  versaoAtual Int       @default(1)
  arquivoUrl  String?
  modeloId     String?
  modeloVersao Int?
  geradoEm     DateTime?
  geradoPor    String?
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  versoes ContratoVersao[]
}

// Histórico de versões do contrato — cada salvamento de conteúdo gera uma nova
// versão; nunca sobrescrevemos versões anteriores.
model ContratoVersao {
  id         String   @id @default(cuid())
  contratoId String
  contrato   Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  numero     Int      // v1, v2, v3...
  conteudo   String
  criadoPor  String?
  createdAt  DateTime @default(now())

  @@unique([contratoId, numero])
}

// ── Configurações ─────────────────────────────────────────────────────────────

model MetodoPagamento {
  id        String   @id @default(cuid())
  nome      String
  ativo     Boolean  @default(true)
  ordem     Int      @default(0)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Arquivos enviados (imagens de logo, fotos de itens etc.)
// Banco de preços de mercado — alimentado por PDFs de orçamentos de
// concorrentes/parceiros analisados pela IA. Base das sugestões de preço.
model PrecoMercado {
  id          String   @id @default(cuid())
  companyId   String
  equipamento String   // nome do equipamento como aparece no orçamento
  marca       String?
  modelo      String?
  fonte       String?  // empresa que tem/oferece este equipamento (concorrente/parceiro)
  diaria      Float?
  semana      Float?
  quinzena    Float?
  mes         Float?
  reposicao   Float?
  documento   String?  // nome do PDF de origem
  createdAt   DateTime @default(now())
}

// OS recebida de um posto de serviço (cliente isPostoServico), interpretada
// pela IA. A extração fica guardada: as OSs de cada posto seguem um padrão,
// então a última importação vira exemplo nas próximas análises do mesmo posto.
model OsPostoImportada {
  id          String   @id @default(cuid())
  companyId   String
  clienteId   String?  // posto (Contact) identificado
  orcamentoId String?  // orçamento criado a partir desta OS
  documento   String   // nome do arquivo ou "texto colado"
  dados       Json     // extração estruturada da IA
  createdAt   DateTime @default(now())

  @@index([companyId])
  @@index([clienteId])
}

// Snapshot de backup da empresa (JSON gzip de todas as tabelas, sem imagens)
model BackupSnapshot {
  id         String   @id @default(cuid())
  companyId  String
  tamanho    Int      // bytes do arquivo comprimido
  dados      Bytes    // JSON gzip
  automatico Boolean  @default(false)
  criadoPor  String?
  createdAt  DateTime @default(now())
}

model Arquivo {
  id        String   @id @default(cuid())
  nome      String
  mime      String
  tamanho   Int
  dados     Bytes
  companyId String
  createdAt DateTime @default(now())
}

// Bancos/contas da empresa para o fluxo de caixa
model Banco {
  id        String   @id @default(cuid())
  nome      String
  ativo     Boolean  @default(true)
  ordem     Int      @default(0)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transacoes Transacao[]
}

model ModeloContrato {
  id        String   @id @default(cuid())
  nome      String
  conteudo  String   @default("")
  ativo     Boolean  @default(true)
  padrao    Boolean  @default(false)
  versao    Int      @default(1)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Links ─────────────────────────────────────────────────────────────────────

model Link {
  id         String   @id @default(cuid())
  nome       String
  url        String
  observacao String?
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ── Ajuda (histórico de conversas com o assistente de IA) ─────────────────────

model AjudaConversa {
  id        String   @id @default(cuid())
  companyId String
  userId    String   // dono da conversa (cada usuário vê as suas)
  titulo    String
  mensagens Json     // [{ role: "user"|"assistant", content: string }]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, userId])
}
